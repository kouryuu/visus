{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "author": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "entities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "label",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "groups": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "implementation",
                    "tests",
                    "config",
                    "docs",
                    "refactor",
                    "dependencies",
                    "generated",
                    "other"
                  ]
                },
                "refs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "refs"
              ],
              "additionalProperties": false
            }
          },
          "decisions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                },
                "inspect": {
                  "type": "string"
                },
                "refs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "summary",
                "refs"
              ],
              "additionalProperties": false
            }
          },
          "impact": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "inferred"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "refs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "from",
                "to",
                "level",
                "summary",
                "refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "groups",
          "decisions",
          "impact"
        ],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refs",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "parent",
    "scope",
    "sourceId",
    "publishedAt",
    "author",
    "entities",
    "stories",
    "exclusions"
  ],
  "additionalProperties": false
}

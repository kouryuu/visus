{
  "name": "diff-vis-vscode",
  "displayName": "diff-vis Change Explorer",
  "description": "Explore agent-authored change stories and snapshot evidence.",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:diffVis.openExplorer"],
  "contributes": { "commands": [{ "command": "diffVis.openExplorer", "title": "diff-vis: Open Change Explorer" }, { "command": "diffVis.prepareReview", "title": "diff-vis: Prepare Review" }] },
  "scripts": { "build": "vite build --config ../../packages/explorer/vite.config.ts --outDir ../../apps/vscode/media --emptyOutDir && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "dependencies": { "@diff-vis/core": "0.1.0" }
}

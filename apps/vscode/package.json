{
  "name": "visus-vscode",
  "displayName": "visus Change Explorer",
  "icon": "icon.png",
  "description": "Explore agent-authored change stories and snapshot evidence.",
  "version": "0.2.0",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:visus.openExplorer"],
  "contributes": { "commands": [{ "command": "visus.openExplorer", "title": "visus: Open Change Explorer" }, { "command": "visus.prepareReview", "title": "visus: Prepare Review" }] },
  "scripts": { "build": "vite build --config ../../packages/explorer/vite.config.ts --outDir ../../apps/vscode/media --emptyOutDir && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "dependencies": { "@visus/core": "0.1.0" }
}
